# Copie para .env. Não publique credenciais reais.
DB_URL=jdbc:postgresql://HOST_DO_SESSION_POOLER:5432/postgres?sslmode=require&connectTimeout=10
DB_USERNAME=postgres.REFERENCIA_DO_PROJETO
DB_PASSWORD=PREENCHA_LOCALMENTE
COOKIE_SECURE=false
# Opcional, somente para banco de demonstração. Não redefine contas já existentes.
DEMO_ENABLED=false
DEMO_PASSWORD=

# Conta cliente autorizada a alternar perfis para apresentação; vazio desabilita.
PRESENTATION_USERNAME=
